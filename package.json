{
  "name": "miniapp-agent",
  "version": "0.1.0",
  "packageManager": "bun@1.3.14",
  "description": "Fast, agent-first automation runtime for WeChat Mini Programs",
  "type": "module",
  "bin": {
    "miniapp-agent": "./dist/src/cli.js"
  },
  "exports": {
    ".": "./dist/src/index.js"
  },
  "files": [
    "dist/src",
    "scripts",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node scripts/clean.mjs",
    "dev": "bun run build && node dist/src/cli.js",
    "setup": "bun run build && node scripts/setup.mjs",
    "skill:install": "node scripts/install-skill.mjs --target codex",
    "skill:install:agents": "node scripts/install-skill.mjs --target agents",
    "skill:install:all": "node scripts/install-skill.mjs --target all",
    "test": "bun run build && node --test \"dist/test/**/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "skill:validate": "python3 ${CODEX_HOME:-$HOME/.codex}/skills/.system/skill-creator/scripts/quick_validate.py skills/miniapp-agent",
    "prepublishOnly": "bun run test && bun run skill:validate"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "wechat",
    "miniprogram",
    "automation",
    "agent",
    "codex",
    "skill"
  ],
  "license": "MIT",
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.2"
  }
}
